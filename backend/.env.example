SECRET_KEY=change-me
# True for local development only. With False, SECRET_KEY must be a real random value.
DEBUG=True
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ocris_bcs
SEED_PASSWORD=change-me
# Encrypts uploaded scans and backups. Required when DEBUG is False. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a copy somewhere other than this server: without it, encrypted files cannot be read.
DATA_ENCRYPTION_KEY=

# Optional
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# ALLOWED_HOSTS=localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000   (the default with DEBUG=True; none otherwise)
# TOKEN_TTL_HOURS=12
# LOGIN_MAX_ATTEMPTS=5            (wrong passwords per username before sign-in is refused)
# LOGIN_MAX_ATTEMPTS_PER_IP=20
# LOGIN_LOCKOUT_MINUTES=15
# RESET_MAX_REQUESTS=5            (forgot-password requests per address per window)
# TRUSTED_PROXY_COUNT=1           (proxies in front of the server; on a cloud host check it at /api/server/client-address/)
# AUTH_COOKIE_SAMESITE=Lax        (None only when the site and the server are on different domains; needs HTTPS)
# MAX_UPLOAD_MB=20
# AUDIT_LOG_FILE=logs/audit.jsonl
# OCR_CONFIDENCE_THRESHOLD=90
# OCR_MAX_CONCURRENT=2             (forms read at once per server process, about 300 MB each; more uploads wait)
# REQUIRE_HTTPS=True   (the default whenever DEBUG is False)
# PENDING_SCAN_DAYS=7              (unsaved uploads are deleted after this many days; 0 keeps them)
# BACKUP_KEEP=14                   (backup files kept by `manage.py maintenance`)
# MAINTENANCE_HOUR=2               (Manila time of the nightly upkeep run by `manage.py maintenance_loop`)
# DATA_DIR=                        (folder for db.sqlite3, media, logs and backups; default: this folder)
# FRONTEND_DIST=                   (the built site, served by this server on its own address; set in the Dockerfile)
# ENABLE_DJANGO_ADMIN=False        (the /admin/ site; on by default only with DEBUG=True)
